{
 "uid": "ecodata-s11",
 "title": "S11 - BI/ML distribuido EcoData",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-5m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS_PROMETHEUS",
    "type": "datasource",
    "query": "prometheus",
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Eventos procesados (batch)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "lambda26_bi_eventos_total",
     "refId": "A",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false,
     "fields": ""
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
